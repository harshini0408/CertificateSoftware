# ══════════════════════════════════════
# PSG iTech Certificate Platform — .env
# ══════════════════════════════════════

# ── App ──────────────────────────────
APP_ENV=production
SECRET_KEY=replace-with-random-64-char-hex-string
ALGORITHM=HS256
FRONTEND_URL=https://sdc2.psgitech.ac.in
ALLOWED_ORIGINS=https://sdc2.psgitech.ac.in
BASE_URL=https://sdc2.psgitech.ac.in/project-name/api

# ── MongoDB ──────────────────────────
MONGODB_URL=mongodb://mongodb:27017
DB_NAME=certsoftware

# ── JWT ──────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Storage ──────────────────────────
STORAGE_PATH=/data/storage

# ── Email (Primary) ──────────────────
EMAIL_PROVIDER=gmail_smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=certs@psgit.edu
EMAIL_SENDER_NAME=PSG iTech Certificates
EMAIL_DAILY_LIMIT=500

# ── Email (Secondary fallback) ───────
SECONDARY_SMTP_HOST=
SECONDARY_SMTP_PORT=587
SECONDARY_SMTP_USER=
SECONDARY_SMTP_PASSWORD=
SECONDARY_EMAIL_SENDER=
SECONDARY_EMAIL_SENDER_NAME=

# ── Super Admin Seed ─────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-on-first-run
SUPERADMIN_EMAIL=admin@psgit.edu
SUPERADMIN_NAME=Platform Admin
